{
  "name": "react-email-monorepo",
  "version": "0.0.0",
  "description": "Asymmetric.al PDF Document Builder fork of React Email.",
  "private": true,
  "scripts": {
    "asym:baseline-smoke": "tsx scripts/asym-baseline-smoke.ts",
    "asym:dep-map": "tsx scripts/asym-editor-dep-map.ts --write",
    "asym:dep-map:check": "tsx scripts/asym-editor-dep-map.ts --check",
    "asym:editor-export-smoke": "tsx scripts/asym-editor-export-smoke.ts",
    "asym:package-strategy-smoke": "tsx scripts/asym-package-strategy-smoke.ts",
    "asym:phase-08-document-names-smoke": "tsx scripts/asym-phase-08-document-names-smoke.ts",
    "build": "turbo run build",
    "canary:enter": "changeset pre enter canary",
    "canary:exit": "changeset pre exit",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "release": "turbo run build --filter=./packages/* && pnpm changeset publish",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "version": "changeset version && pnpm install --no-frozen-lockfile && pnpm lint:fix",
    "core-pdf:check": "turbo run lint typecheck test build --filter=@asym/docraptor-client --filter=@asym/pdf-template-schema --filter=@asym/pdf-renderer --filter=@asym/pdf-editor --filter=@asym/pdf-studio-adapter --force",
    "core-pdf:render": "node scripts/verify-core-pdf-rendering.mjs",
    "core-pdf:browser": "pnpm --filter @asym/pdf-editor test:browser"
  },
  "devDependencies": {
    "@actions/core": "3.0.0",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.0",
    "@actions/http-client": "4.0.0",
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "2.30.0",
    "@changesets/pre": "2.0.2",
    "@manypkg/get-packages": "3.1.0",
    "@octokit/core": "7.0.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "20.14.6",
    "mdast-util-to-string": "4.0.0",
    "nypm": "catalog:",
    "pkg-pr-new": "0.0.66",
    "remark": "15.0.1",
    "rollup": "4.60.1",
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "@tsdown/css": "catalog:",
    "tsx": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": "24.x"
  }
}
