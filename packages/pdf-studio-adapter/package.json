{
  "name": "@asym/pdf-studio-adapter",
  "version": "0.1.0",
  "description": "Core integration adapter contract for the Asym PDF Document Builder.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**",
    "readme.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asymmetric-al/react-PDF.git",
    "directory": "packages/pdf-studio-adapter"
  },
  "keywords": [
    "asym",
    "pdf",
    "adapter",
    "core"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "@asym/docraptor-client": "workspace:*",
    "@asym/pdf-renderer": "workspace:*",
    "@asym/pdf-editor": "workspace:*",
    "@asym/pdf-template-schema": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "devDependencies": {
    "tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "vitest": "5.0.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "catalog:"
  }
}
